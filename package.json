{
  "name": "glav",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --config cloud/wrangler.jsonc",
    "build": "wrangler deploy --config cloud/wrangler.jsonc --dry-run",
    "deploy": "wrangler deploy --config cloud/wrangler.jsonc",
    "typecheck": "tsc --project cloud/tsconfig.json --noEmit",
    "test": "cd cloud && node --test test/*.test.mjs test/*.test.ts",
    "check:cache": "cd cloud && node scripts/check-cache.mjs",
    "check:access": "cd cloud && node scripts/check-access.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
