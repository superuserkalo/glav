telegram_key="<your_telegram_api_key_here>"
OPENAI_API_KEY="<your_openai_api_key_here>"
# Telegram user IDs that may use the bot, comma separated. Empty means nobody; message the bot to learn your ID.
allowed_users=""
# Shared by the bot and the agent so nothing else on this machine can pose as either. Generate: openssl rand -hex 32
agent_secret=""

# Optional, shown with their defaults.
# model_provider="openai"
# model_id="gpt-6-luna"
# transcribe_model="gpt-transcribe"
# system_prompt="You are Glav, ..."
# workspace="data/workspace"   # where the agent works; relative to agent/, or absolute, or ~/...
# inbox_dir="agent/data/workspace/inbox"   # where received files are saved; keep it inside the workspace
# mcp_config="mcp.json"   # MCP servers to connect to; relative to agent/. See agent/mcp.example.json
# agent_addr="127.0.0.1:8787"
# send_addr="127.0.0.1:8788"
